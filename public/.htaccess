# === Ракушка65 — конфигурация Apache ===

Options -Indexes
DirectoryIndex index.html

# MIME-типы: без них некоторые хостинги отдают .js как text/plain,
# и браузер отказывается выполнять ES-модули (пустой экран при рабочем CSS).
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType image/webp .webp
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ВАЖНО: принудительный редирект на https здесь НЕ делаем.
  # На хостингах с SSL-терминацией на прокси (REG.RU и др.) Apache видит соединение
  # как http даже при https, из-за чего RewriteRule на https уходит в бесконечную петлю
  # (ERR_TOO_MANY_REDIRECTS). HTTPS и www->без www включаются тумблером в панели хостинга.

  # Реальные файлы и каталоги (ассеты, шрифты, картинки, пререндер-папки) отдаём как есть.
  # Это гарантирует, что /assets/*.js никогда не подменится на index.html (иначе пустой экран).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Если для маршрута есть пререндер-файл /path/index.html — отдаём его
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # SPA-фолбэк: всё остальное обслуживает корневой index.html
  RewriteRule ^ /index.html [L]
</IfModule>

# === Сжатие ===
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# === Кеширование ===
<IfModule mod_expires.c>
  ExpiresActive On
  # Хешированные ассеты Vite (immutable) — год
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML — не кешируем агрессивно, чтобы обновления SEO/контента подхватывались
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# UTF-8 по умолчанию
AddDefaultCharset UTF-8
